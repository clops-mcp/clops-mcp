# Same agent as Dockerfile.clops, but installing a locally-built wheel instead
# of pulling from a git URL.
#
# Why this exists: `Dockerfile.clops` installs `${CLOPS_SPEC}`, which defaults to
# `git+https://github.com/clops-mcp/clops-mcp`. That only resolves once the repo
# is public. Until then — and any time you want to test an uncommitted change —
# build the wheel and install that:
#
#   uv build                                            # at the repo root
#   mkdir -p deploy/context-forge/wheels
#   cp dist/clops_mcp-*.whl deploy/context-forge/wheels/
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build
#
# This also happens to be the better test: it exercises the actual distribution
# artifact that PyPI will serve, rather than a source checkout.

FROM python:3.12-slim

# Only for its `translate` module — the stdio→HTTP bridge. The gateway proper
# runs in its own container.
RUN pip install --no-cache-dir mcp-contextforge-gateway

# `wheels/` is gitignored and must be populated before building. A glob COPY
# fails the build outright if it matches nothing, which is the behaviour we
# want: better than silently producing an image with no clops in it.
COPY wheels/clops_mcp-*.whl /tmp/wheels/
RUN pip install --no-cache-dir /tmp/wheels/*.whl && rm -rf /tmp/wheels

ENV CLOPS_LIBRARY=clops.stdlib.business_designer
ENV CLOPS_PORT=9000

EXPOSE 9000

# --host is load-bearing: translate defaults to 127.0.0.1, which inside a
# container means nothing outside it can connect.
CMD python -m mcpgateway.translate \
      --stdio "clops-server --library ${CLOPS_LIBRARY}" \
      --expose-sse \
      --expose-streamable-http \
      --host 0.0.0.0 \
      --port ${CLOPS_PORT}
