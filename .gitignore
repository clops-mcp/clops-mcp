__pycache__/
*.py[cod]
*.egg-info/
*.egg
.pytest_cache/
.coverage
dist/
build/
.venv/
.claude/.clops/

# Agent scratch space — full repo copies, not source.
.claude/worktrees/

# Real secrets for the deployment examples. `.env.example` is the tracked one.
.env
.env.secrets
deploy/**/.env

# Locally-built wheels staged into a deploy build context — build output, and
# large. See deploy/context-forge/Dockerfile.clops.local.
deploy/**/wheels/

# Working notes. Kept on disk because they are genuinely useful, kept out of
# git because a repo publishes everything forever — including anything you
# delete later. If a note is meant for readers, it goes in docs/ instead.
internal/

# MANIFEST.in already prunes this from the sdist, but that does nothing for
# git — untracked and unignored, one `git add -A` commits it. Delete this line
# when it is ready to show.
landing-page/

# Local Claude Code project settings. Kept on disk, out of the repo.
.claude/settings.json
