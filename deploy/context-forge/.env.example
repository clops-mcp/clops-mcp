# Copy to `.env`, then fill in real secrets:
#
#   cp .env.example .env
#   pip install mcp-contextforge-gateway   # or: uvx --from mcp-contextforge-gateway
#   python3 -m mcpgateway.scripts.init_secrets --patch-env .env
#
# The gateway will not start with placeholder values.

# --- required by the gateway ------------------------------------------------
JWT_SECRET_KEY=
AUTH_ENCRYPTION_SECRET=

# --- admin login (Admin UI at http://localhost:4444/admin) ------------------
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=

# --- which clops to install in the agent image ------------------------------
# Not on PyPI yet, so this defaults to the repo. After publishing:
#   CLOPS_SPEC=clops-mcp==0.3.0
# Pin a tag for anything you care about: git+https://github.com/wesley-harding/clops@v0.3.0
CLOPS_SPEC=git+https://github.com/wesley-harding/clops

# --- which Op library this agent serves -------------------------------------
# The default ships inside the clops wheel, so it needs no extra files.
# Swap for your own library — see README §"Using your own Op library".
CLOPS_LIBRARY=clops.stdlib.business_designer
